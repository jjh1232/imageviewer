{
  // Cloudflare Workers (Static Assets). 빌드 결과 out/ 를 올린다 (Next.js 정적 내보내기 — 헌법 §4).
  //
  // ⚠ directory 를 "." 으로 바꾸지 말 것. 저장소 루트를 올리면 소스와 CLAUDE.md 가 같이 공개된다.
  "name": "imageviewer",
  "compatibility_date": "2026-09-15",

  // 자산 앞단에서 /imageviewer 접두사를 떼고, 언어 없는 /imageviewer 을 언어판으로 302 한다.
  "main": "./worker/index.js",

  // prelaps-router 의 prelaps.com/* 와 겹치지만 더 구체적인 라우트가 이긴다.
  // 커스텀 도메인은 붙이지 않는다 — 같은 내용이 두 주소로 열려 중복 콘텐츠가 된다.
  //
  // ⚠ "prelaps.com/imageviewer" 와 "/imageviewer/*" 두 개로 나누지 말 것. 끝에 * 가 없는 패턴은
  // 쿼리가 붙은 /imageviewer?utm_source=… 에 안 걸려 라우터 → 허브 404 로 떨어진다 (doceditor 2026-09-16).
  // /imageviewerxyz 도 여기 걸리지만 Worker 가 「접두사로 시작만 하는 경로」 로 보고 404 를 준다.
  "routes": [
    { "pattern": "prelaps.com/imageviewer*", "zone_name": "prelaps.com" }
  ],

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // 기본은 「자산 먼저, 없으면 Worker」 라 접두사를 떼기 전에 조회가 빗나간다. 순서를 뒤집는다.
    "run_worker_first": true,

    // next.config 의 trailingSlash:false 와 세트다 (out/ko.html).
    // /ko → ko.html 200, /ko/ → /ko 로 리다이렉트. canonical·sitemap 이 전부 끝 슬래시 없음.
    "html_handling": "drop-trailing-slash",

    // 없는 주소는 404.html 을 status 404 로. 없으면 soft 404 가 된다.
    "not_found_handling": "404-page"
  }
}
